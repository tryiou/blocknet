# /etc/conf.d/blocknetd: config file for /etc/init.d/blocknetd

# Config file location
#BLOCKNETD_CONFIGFILE="/etc/blocknet/blocknet.conf"

# What directory to write pidfile to?  (created and owned by $BLOCKNETD_USER)
#BLOCKNETD_PIDDIR="/var/run/blocknetd"

# What filename to give the pidfile
#BLOCKNETD_PIDFILE="${BLOCKNETD_PIDDIR}/blocknetd.pid"

# Where to write blocknetd data (be mindful that the blockchain is large)
#BLOCKNETD_DATADIR="/var/lib/blocknetd"

# User and group to own blocknetd process
#BLOCKNETD_USER="blocknet"
#BLOCKNETD_GROUP="blocknet"

# Path to blocknetd executable
#BLOCKNETD_BIN="/usr/bin/blocknetd"

# Nice value to run blocknetd under
#BLOCKNETD_NICE=0

# Additional options (avoid -conf and -datadir, use flags above)
#BLOCKNETD_OPTS=""

# The timeout in seconds OpenRC will wait for blocknetd to terminate
# after a SIGTERM has been raised.
# Note that this will be mapped as argument to start-stop-daemon's
# '--retry' option, which means you can specify a retry schedule
# here. For more information see man 8 start-stop-daemon.
BLOCKNETD_SIGTERM_TIMEOUT=60
