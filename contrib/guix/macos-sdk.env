# Pinned macOS SDK for Guix darwin builds.
# Follows upstream bitcoin/bitcoin#34036 (Xcode 26.1.1). Tarball is hosted by
# bitcoincore.org and hash-verified on every fetch — same trust model as any
# depends source tarball. Source it, then fetch+extract:
#   source contrib/guix/macos-sdk.env
#   mkdir -p depends/SDKs
#   curl --location --fail "$MACOS_SDK_URL/$MACOS_SDK_NAME.tar" -o /tmp/macos-sdk.tar
#   printf '%s %s\n' "$MACOS_SDK_SHA256" /tmp/macos-sdk.tar | sha256sum --check
#   tar -C depends/SDKs -xf /tmp/macos-sdk.tar
export MACOS_SDK_NAME="Xcode-26.1.1-17B100-extracted-SDK-with-libcxx-headers"
export MACOS_SDK_URL="https://bitcoincore.org/depends-sources/sdks"
export MACOS_SDK_SHA256="9600fa93644df674ee916b5e2c8a6ba8dacf631996a65dc922d003b98b5ea3b1"
